{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "lint": {},
    "typecheck": {},
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/docker/postgres/**",
        "$TURBO_ROOT$/.env.test"
      ],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
