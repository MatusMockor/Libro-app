{
  "name": "libro-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "docker compose watch",
    "dev:restart": "docker compose up --detach --force-recreate --no-build --wait",
    "dev:host": "turbo run dev",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up --detach --wait postgres",
    "db:migrate": "pnpm --filter @libro/api run migration:run",
    "db:migrate:revert": "pnpm --filter @libro/api run migration:revert",
    "db:migration:generate": "pnpm --filter @libro/api run migration:generate",
    "db:migration:create": "pnpm --filter @libro/api run migration:create",
    "db:migration:check": "pnpm --filter @libro/api run migration:check",
    "db:seed": "pnpm --filter @libro/api run seed:run",
    "accounts:purge-deleted": "pnpm --filter @libro/api run accounts:purge-deleted"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
