{
  "name": "@libro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run start:dev",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typeorm": "node --import @oxc-node/core/register node_modules/typeorm/cli.js",
    "migration:run": "pnpm run typeorm migration:run --dataSource src/database/data-source.ts",
    "migration:revert": "pnpm run typeorm migration:revert --dataSource src/database/data-source.ts",
    "migration:generate": "sh -c 'pnpm run typeorm migration:generate \"src/database/migrations/${1:?missing migration name}\" --dataSource src/database/data-source.ts --pretty && prettier --write src/database/migrations' sh",
    "migration:create": "sh -c 'pnpm run typeorm migration:create \"src/database/migrations/${1:?missing migration name}\" && prettier --write src/database/migrations' sh",
    "migration:check": "pnpm run typeorm migration:generate src/database/migrations/SchemaDrift --dataSource src/database/data-source.ts --check",
    "accounts:purge-deleted": "node --import @oxc-node/core/register src/cli/purge-deleted-accounts.ts",
    "seed:run": "node --import @oxc-node/core/register node_modules/typeorm-extension/bin/cli.mjs seed:run --dataSource src/database/data-source.ts --preserveFilePaths"
  },
  "dependencies": {
    "@libro/tree-engine": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "@node-rs/argon2": "2.2.2",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "typeorm": "1.1.2",
    "typeorm-extension": "4.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@oxc-node/core": "1.0.1",
    "@standard-schema/spec": "1.1.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
