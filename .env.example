# Copy to .env (cp .env.example .env). Values below are safe local-only defaults.
# .env is read by docker compose (variable interpolation + env_file) and by the api when it runs on the host.
# .env.local (optional, gitignored) overrides .env for the api on the host. NODE_ENV=test loads .env.test instead.

# Runtime environment of the api: development | test | production
NODE_ENV=development

# Port the api process listens on (inside the container, or on the host when run with pnpm dev:host)
PORT=3000

# Host port of the dockerized api, bound to 127.0.0.1 only
API_PORT=3000

# Host port of the Node inspector of the dockerized api, bound to 127.0.0.1 only
API_DEBUG_PORT=9229

# Postgres superuser and main database created on the first start of an empty volume.
# The test database "${POSTGRES_DB}_test" (libro_app_test) is created next to it.
POSTGRES_USER=libro_app
POSTGRES_PASSWORD=libro_app
POSTGRES_DB=libro_app

# Host port of the dockerized Postgres, bound to 127.0.0.1 only. Not 5432 to avoid clashing with other Postgres instances.
DB_PORT=5433

# Connection URL used from the host (api via pnpm dev:host, migrations, psql).
# Inside docker compose the api gets its own DATABASE_URL pointing to the "postgres" service, so this value is not used there.
DATABASE_URL=postgres://libro_app:libro_app@127.0.0.1:5433/libro_app
